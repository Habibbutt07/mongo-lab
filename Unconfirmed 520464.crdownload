#!/usr/bin/env python3
"""Generates users.json (50) and orders.json (600) for Topic 7.
Uses MongoDB Extended JSON ($oid / $date) so mongoimport creates real ObjectId and Date types."""
import json, random, datetime

random.seed(7)
N_USERS, N_ORDERS = 50, 600

def oid(n):                       # deterministic 24-hex ObjectId string
    return f"{n:024x}"

users = [{"_id": {"$oid": oid(i + 1)},
          "name": f"Customer {i + 1}",
          "email": f"customer{i + 1}@example.com",
          "country": random.choice(["LV", "LT", "EE", "DE", "PL"])}
         for i in range(N_USERS)]

catalog = {
    "electronics": (80, 1500), "books": (8, 60), "clothing": (15, 180),
    "home": (20, 250), "toys": (10, 90),
}
start = datetime.datetime(2025, 1, 1)
end   = datetime.datetime(2026, 11, 5)
span  = int((end - start).total_seconds())

orders = []
for i in range(N_ORDERS):
    items = []
    for _ in range(random.randint(1, 4)):
        cat = random.choice(list(catalog))
        lo, hi = catalog[cat]
        items.append({"sku": f"SKU-{random.randint(1000, 9999)}",
                      "category": cat,
                      "price": round(random.uniform(lo, hi), 2),
                      "qty": random.randint(1, 5)})
    amount = round(sum(it["price"] * it["qty"] for it in items), 2)
    d = start + datetime.timedelta(seconds=random.randint(0, span))
    orders.append({"customerId": {"$oid": oid(random.randint(1, N_USERS))},
                   "orderDate": {"$date": d.strftime("%Y-%m-%dT%H:%M:%SZ")},
                   "items": items,
                   "amount": amount,
                   "status": random.choice(["new", "paid", "shipped", "delivered"])})

json.dump(users,  open("users.json", "w"),  indent=1)
json.dump(orders, open("orders.json", "w"), indent=1)
print(f"users.json: {len(users)} docs, orders.json: {len(orders)} docs")
