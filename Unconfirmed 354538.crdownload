// =====================================================================
// Topic 6 - MongoDB I: document model, BSON, CRUD
// Run:  mongosh "mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/" --file topic6.js
// (products.json must already be imported with mongoimport - see GUIDE.md, step A3)
// =====================================================================

// In a script file `use shop_db` is not allowed, so we select the DB like this:
db = db.getSiblingDB("shop_db");   // equivalent of: use shop_db

// ---------- 0. Sanity check of the import ----------
print("Total products:", db.products.countDocuments());   // expect 60
printjson(db.products.findOne());                         // look at one BSON document

// ---------- 1. READ: 8+ distinct find() queries ----------
// Q1: range query - price between 50 and 200 inclusive
print("Q1 count:", db.products.find({ price: { $gte: 50, $lte: 200 } }).count());

// Q2: $in - category is electronics OR books
print("Q2 count:", db.products.find({ category: { $in: ["electronics", "books"] } }).count());

// Q3: $and - electronics cheaper than 500
printjson(db.products.find({ $and: [{ category: "electronics" }, { price: { $lt: 500 } }] }).limit(3).toArray());

// Q4: sort + skip + limit (pagination: 3rd page of 5 most expensive items)
printjson(db.products.find({}, { name: 1, price: 1, _id: 0 }).sort({ price: -1 }).skip(10).limit(5).toArray());

// Q5: $or - very cheap OR nearly out of stock
print("Q5 count:", db.products.find({ $or: [{ price: { $lt: 20 } }, { stock: { $lt: 10 } }] }).count());

// Q6: array field - products having tag "premium"
print("Q6 count:", db.products.find({ tags: "premium" }).count());

// Q7: $all on arrays - tagged BOTH "new" and "popular"
print("Q7 count:", db.products.find({ tags: { $all: ["new", "popular"] } }).count());

// Q8: $ne / $nin + projection - everything except discontinued, show only name/price
printjson(db.products.find({ category: { $nin: ["discontinued"] } }, { name: 1, price: 1, _id: 0 }).limit(3).toArray());

// Q9: regex - names starting with "Phone"
print("Q9 count:", db.products.find({ name: /^Phone/ }).count());

// Q10: $exists + $size - documents with exactly 2 tags
print("Q10 count:", db.products.find({ tags: { $size: 2 }, stock: { $exists: true } }).count());

// ---------- 2. UPDATE ----------
// U1: updateMany + $mul - raise all electronics prices by 10 %
var before = db.products.findOne({ category: "electronics" });
printjson({ name: before.name, priceBefore: before.price });
var r1 = db.products.updateMany({ category: "electronics" }, { $mul: { price: 1.10 } });
print("U1 matched/modified:", r1.matchedCount, r1.modifiedCount);
printjson(db.products.findOne({ _id: before._id }, { name: 1, price: 1 }));   // price is now ~1.1x

// U2: updateOne + $addToSet - add tag "sale" only if not already present (idempotent)
var one = db.products.findOne({ category: "books" });    // replaces the ObjectId("...") placeholder
db.products.updateOne({ _id: one._id }, { $addToSet: { tags: "sale" } });
db.products.updateOne({ _id: one._id }, { $addToSet: { tags: "sale" } });   // 2nd run: no duplicate
printjson(db.products.findOne({ _id: one._id }, { name: 1, tags: 1 }));

// ---------- 3. UPSERT of stock quantity ----------
// If no stock document exists for this product it is created, otherwise it is updated.
var rUp = db.stock.updateOne(
  { productId: one._id },
  { $set: { quantity: 42 } },
  { upsert: true }
);
printjson(rUp);                                       // 1st run: upsertedId is set
rUp = db.stock.updateOne({ productId: one._id }, { $set: { quantity: 42 } }, { upsert: true });
printjson(rUp);                                       // 2nd run: matchedCount 1, no upsert
printjson(db.stock.findOne({ productId: one._id }));

// ---------- 4. DELETE with count before / after ----------
print("discontinued BEFORE:", db.products.countDocuments({ category: "discontinued" }));
var d = db.products.deleteMany({ category: "discontinued" });
print("deleted:", d.deletedCount);
print("discontinued AFTER :", db.products.countDocuments({ category: "discontinued" }));   // 0

// ---------- 5. Extra: replaceOne vs updateOne+$set (for self-check Q1) ----------
// replaceOne swaps the WHOLE document (except _id); fields not in the new doc are lost.
// updateOne+$set changes only the listed fields.
var t = db.products.findOne({ category: "toys" });
db.products.updateOne({ _id: t._id }, { $set: { stock: 1 } });                        // keeps name/price/tags
printjson(db.products.findOne({ _id: t._id }));
db.products.replaceOne({ _id: t._id }, { name: t.name, price: t.price, category: "toys" });  // tags & stock gone
printjson(db.products.findOne({ _id: t._id }));

// ---------- 6. _id immutability demo (for self-check Q2) ----------
try {
  db.products.updateOne({ _id: t._id }, { $set: { _id: new ObjectId() } });
} catch (e) {
  print("Expected error:", e.message);   // "Performing an update on the path '_id' would modify the immutable field '_id'"
}

print("=== Topic 6 finished ===");

/* SELF-CHECK ANSWERS
 1. updateOne+$set sends/rewrites only the changed fields (small oplog entry, atomic field-level change, other
    concurrent writers' fields untouched). replaceOne sends the whole new document, rewrites everything,
    and silently drops any field you forgot - so it is costlier on the network/oplog and riskier.
 2. _id is the primary key: it is the target of the mandatory unique index, it identifies the document in the
    oplog, in replication and in sharding (chunk location / shard key may include it). Changing it would
    really mean "delete + insert a different document", so MongoDB forbids it.
 3. An upsert is NOT atomic across concurrent requests unless the filter field has a UNIQUE index. Two parallel
    upserts both find nothing and both insert -> duplicates. Fix: create a unique index on the filter field
    (e.g. stock.productId) so one upsert fails with E11000 and can be retried.
*/
